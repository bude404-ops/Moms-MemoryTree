# Moms MemoryTree environment template
# Copy this file to .env.local for local development only.
# Keep this file placeholder-only. Never commit real credentials.

# Required app environment. Allowed values: development, staging, production.
VITE_APP_ENV=development

# Current external data provider values.
# Use a development/staging/production project value from the provider dashboard.
# Publishable client keys only. Never use service-role keys in frontend env vars.
VITE_SUPABASE_URL=https://your-supabase-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional live verification harness values.
# Use throwaway test accounts only. Do not use service-role keys.
SUPABASE_LIVE_URL=https://your-supabase-project-ref.supabase.co
SUPABASE_LIVE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_LIVE_TEST_PASSWORD=replace-with-throwaway-password

# Optional if email confirmation is enabled and test users are pre-created/confirmed.
SUPABASE_LIVE_TEST_EMAIL_A=
SUPABASE_LIVE_TEST_EMAIL_B=
SUPABASE_SIGNED_MEDIA_FUNCTION=signed-media-access
